generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model agency {
  name    String
  address String
  picture String
  twitter String
  id      String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
}

model calltoaction {
  id          String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String
  description String
}

model categories {
  id      String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  jobname String
  name    String
}

model documentation {
  id                String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  image1            String
  image1description String
  image2            String
  iamge2description String
}

model employeedata {
  name          String
  lastname      String
  age           Int
  address       String
  job           String
  education     String
  experience    String
  specialskills String
  sss           String
  pagibig       String
  tin           String
  philhealh     String
  picture       String
  twitter       String
  id            String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
}

model herocontent {
  id          String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String
  description String
  image       String
}

model navbarcontent {
  name String
  url  String
  id   String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
}

model navbardata {
  dataname String
  style    String
  id       String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
}

model aboutus {
  user_id     String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String
  description String
  jobseekers  jobseekers[]
  agencies    agencies[]
}

model agencies {
  user_id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  value          String?  @db.VarChar(500)
  description    String?  @db.VarChar(500)
  aboutus        aboutus? @relation(fields: [aboutusUser_id], references: [user_id])
  aboutusUser_id String?  @db.Uuid
}

model jobseekers {
  user_id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title          String?  @db.VarChar(500)
  description    String?  @db.VarChar(500)
  aboutus        aboutus? @relation(fields: [aboutusUser_id], references: [user_id])
  aboutusUser_id String?  @db.Uuid
}

model userchoices {
  user_id     String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String? @db.VarChar(500)
  description String? @db.VarChar(500)
}

enum author {
  ADMIN
  AGENCY
  APPLICANT
}
